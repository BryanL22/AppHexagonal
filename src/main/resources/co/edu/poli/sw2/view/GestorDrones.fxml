<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="TOP_LEFT"
      spacing="25.0"
      minWidth="1180"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.sw2.infraestructura.ui.MainController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- COLUMNA IZQUIERDA: Formulario de Dron, Acciones CRUD y Operaciones con Slider/Scroll -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                minWidth="470" prefWidth="510" maxWidth="540" styleClass="panel-izq-scroll"
                style="-fx-background-color: #1e1e2e; -fx-background: #1e1e2e;">
        <VBox spacing="14.0">
            <padding>
                <Insets top="0" right="14" bottom="20" left="0"/>
            </padding>

        <Label text="Gestor de Drones" styleClass="titulo"/>

        <!-- Formulario del dron -->
        <GridPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <columnConstraints>
                <ColumnConstraints minWidth="130" prefWidth="140"/>
                <ColumnConstraints minWidth="200" prefWidth="240"/>
            </columnConstraints>

            <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtId" promptText="Identificador del dron" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Serial:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtSerial" promptText="Numero de serie" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Modelo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtModelo" promptText="Modelo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Fabricante:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtFabricante" promptText="Fabricante" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Peso (kg):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPeso" promptText="Peso en kg" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Tipo:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbTipo" promptText="Selecciona un tipo" prefWidth="240"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label fx:id="lblCapacidadTanque" text="Capacidad tanque (L):"
                   GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCapacidadTanque" promptText="Litros" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label fx:id="lblDeteccionTermica" text="Deteccion termica:"
                   GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <CheckBox fx:id="chkDeteccionTermica" text="Si"
                      GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Botones de accion CRUD -->
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnCrear" text="Crear" prefWidth="140" styleClass="crud-button" onAction="#onCrear"/>
            <Button fx:id="btnConsultarTodos" text="Consultar todos" prefWidth="140" styleClass="crud-button" onAction="#onConsultarTodos"/>
        </HBox>

        <HBox alignment="CENTER" spacing="8">
            <Button text="Consultar por ID" prefWidth="130" styleClass="crud-button" onAction="#onConsultarPorId"/>
            <Button text="Actualizar" prefWidth="100" styleClass="crud-button" onAction="#onActualizar"/>
            <Button text="Eliminar" prefWidth="100" styleClass="crud-button" onAction="#onEliminar"/>
        </HBox>

        <!-- Seccion Clima y Observador -->
        <Label text="Monitoreo Meteorologico y Viabilidad" styleClass="subtitulo"/>

        <GridPane hgap="8" vgap="8" alignment="CENTER_LEFT">
            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="120"/>
                <ColumnConstraints minWidth="160" prefWidth="190"/>
                <ColumnConstraints minWidth="110" prefWidth="120"/>
            </columnConstraints>

            <Label text="Clima por ciudad:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCiudadClima" promptText="Ciudad" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Button fx:id="btnConsultarClima" text="Consultar clima" onAction="#onConsultarClima"
                    GridPane.rowIndex="0" GridPane.columnIndex="2"/>

            <Label text="ID del dron:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtIdSuscripcion" promptText="ID" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Button text="Suscribir" onAction="#onSuscribirClima" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

            <Button text="Desuscribir" onAction="#onDesuscribirClima" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Button text="Suscripciones" onAction="#onVerSuscripcionesClima" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

            <Label text="Suscritos:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblSuscripciones" wrapText="true" maxWidth="310"
                   GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

            <Label fx:id="lblClima" wrapText="true" maxWidth="430"
                   GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
            <Label fx:id="lblViabilidad" wrapText="true" maxWidth="430"
                   GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
        </GridPane>

        <!-- Seccion Operaciones del Dron (Patron Command) -->
        <Label text="Operaciones del Dron (Command)" styleClass="subtitulo"/>

        <GridPane hgap="8" vgap="8" alignment="CENTER_LEFT">
            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="120"/>
                <ColumnConstraints minWidth="160" prefWidth="190"/>
                <ColumnConstraints minWidth="110" prefWidth="120"/>
            </columnConstraints>

            <Label text="Seleccionar dron:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbDronOperacion" promptText="Selecciona un dron" prefWidth="190"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="14" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkTomarFoto" text="Tomar Fotografía"/>
            <CheckBox fx:id="chkEscanearZona" text="Escanear Zona"/>
            <CheckBox fx:id="chkMedirTemperatura" text="Medir Temperatura"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="btnEjecutarComandos" text="Confirmar y Ejecutar Comandos" prefWidth="240" onAction="#onEjecutarComandos"/>
        </HBox>

        <Label fx:id="lblResultadoOperacion" wrapText="true" maxWidth="480" styleClass="operacion-resultado"/>

        <Label fx:id="lblTituloHistorial" text="Historial de Operaciones del Dron Seleccionado:" styleClass="subtitulo"/>
        <ListView fx:id="lvHistorialOperaciones" minHeight="180" prefHeight="200"/>

        <!-- Seccion Calculo de Consumo Energetico de Ruta (Patron Strategy) -->
        <Label text="Consumo Energético de Ruta (Strategy)" styleClass="subtitulo"/>

        <GridPane hgap="8" vgap="8" alignment="CENTER_LEFT">
            <columnConstraints>
                <ColumnConstraints minWidth="130" prefWidth="140"/>
                <ColumnConstraints minWidth="180" prefWidth="200"/>
                <ColumnConstraints minWidth="100" prefWidth="120"/>
            </columnConstraints>

            <!-- 1. Seleccionar dron registrado -->
            <Label text="1. Dron asignado:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbDronEstrategia" promptText="Selecciona un dron" prefWidth="200"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- 2. Cargar ruta JSON -->
            <Label text="2. Cargar ruta JSON:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Button fx:id="btnCargarRuta" text="Seleccionar archivo..." prefWidth="200" onAction="#onCargarRutaJson"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Resumen de ruta cargada -->
            <Label text="Ruta cargada:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblInfoRuta" text="Ninguna ruta cargada" wrapText="true" maxWidth="320"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

            <!-- 3. Seleccionar estrategia de consumo -->
            <Label text="3. Estrategia:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbEstrategiaConsumo" promptText="Selecciona estrategia" prefWidth="200"
                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Button fx:id="btnCalcularConsumo" text="Calcular" prefWidth="110" onAction="#onCalcularConsumo"
                    GridPane.rowIndex="3" GridPane.columnIndex="2"/>

            <!-- 4. Visualizar distancia, estrategia y consumo -->
            <Label text="Distancia:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblDistanciaRuta" text="-- km" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Estrategia aplicada:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="lblEstrategiaSeleccionada" text="--" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Consumo estimado:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Label fx:id="lblConsumoCalculado" text="--" styleClass="operacion-resultado" wrapText="true" maxWidth="320"
                   GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        </GridPane>

        </VBox>
    </ScrollPane>

    <!-- COLUMNA DERECHA: Tabla de la Base de Datos -->
    <VBox spacing="14.0" HBox.hgrow="ALWAYS" minWidth="600" prefWidth="760">

        <Label text="Base de Datos de Drones" styleClass="titulo"/>

        <TableView fx:id="tablaDrones" VBox.vgrow="ALWAYS" minHeight="450" prefHeight="580">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colSerial" text="Serial" prefWidth="110"/>
                <TableColumn fx:id="colModelo" text="Modelo" prefWidth="105"/>
                <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="115"/>
                <TableColumn fx:id="colPeso" text="Peso (kg)" prefWidth="80"/>
                <TableColumn fx:id="colCapacidadTanque" text="Capacidad tanque (L)" prefWidth="145"/>
                <TableColumn fx:id="colDeteccionTermica" text="Deteccion termica" prefWidth="125"/>
            </columns>
        </TableView>

    </VBox>

</HBox>
